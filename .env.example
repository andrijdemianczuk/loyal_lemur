# Copy to .env and adjust. All settings use the ER_ prefix.
# The Anthropic key is read from ./.key (gitignored), falling back to ANTHROPIC_API_KEY.

ER_DATABASE_URL=postgresql+psycopg://er_triage@localhost:5432/er_triage

# value-pitch | pipeline-pitch
ER_DEMO_PROFILE=value-pitch

# Simulated minutes per real second
ER_SIM_SPEED=1.0

# Event sinks: any of console, file, hec
ER_EVENT_SINKS=file
# ER_EVENT_SINKS=file,hec
# ER_HEC_URL=http://localhost:8088
# ER_HEC_TOKEN=
